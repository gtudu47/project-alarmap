# Copier sous .env : cp .env.example .env (Linux)
# ou Copy-Item .env.example .env (PowerShell).
# npm run config:init génère automatiquement une configuration locale sûre.
# Ne jamais versionner .env. Les secrets ci-dessous sont des exemples.
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USER=alarmap
DB_PASSWORD=change_me
DB_NAME=alarmap
API_PORT=3000
# 1 uniquement derrière un proxy contrôlé, avec accès direct API interdit.
TRUST_PROXY=0
EDITOR_PORT=4200
VIEWER_PORT=4201
PUBLIC_APP_URL=http://localhost:8080
JWT_SECRET=change_me_with_a_long_random_secret
STORAGE_DRIVER=local
STORAGE_PATH=./data/assets
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=alarmap
S3_ACCESS_KEY=alarmap
S3_SECRET_KEY=change_me
S3_REGION=us-east-1
AUTO_UPDATE=true
INSTALL_CHANNEL=main
BACKUP_RETENTION=5

# VPS : domaine public sans protocole ni chemin (production Compose).
# ALARMAP_DOMAIN=maps.example.com
