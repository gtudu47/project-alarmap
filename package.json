{
  "name": "alarmap",
  "version": "0.1.0-dev.1",
  "private": true,
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:editor": "ng serve editor --host 127.0.0.1 --port 4200",
    "dev:viewer": "ng serve viewer --host 127.0.0.1 --port 4201",
    "dev:api": "node --env-file=.env --import tsx apps/api/src/main.ts",
    "build": "npm run build:packages && npm run build --workspace @alarmap/api && ng build editor && ng build viewer",
    "build:packages": "npm run build --workspace @alarmap/map-model && npm run build --workspace @alarmap/shared && npm run build --workspace @alarmap/map-engine && npm run build --workspace @alarmap/map-sdk",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.check.json && ngc --noEmit -p apps/editor/tsconfig.app.json && ngc --noEmit -p apps/viewer/tsconfig.app.json",
    "test": "vitest run",
    "test:integration": "node --env-file=.env --import tsx --test apps/api/test/database.integration.ts apps/api/test/accounts.integration.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "node --env-file=.env --import tsx apps/api/src/migrate.ts",
    "config:init": "node scripts/init-env.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "doctor": "node scripts/doctor.mjs",
    "preview": "node scripts/preview.mjs",
    "admin:setup": "node --env-file=.env --import tsx apps/api/src/setup-admin.ts"
  },
  "devDependencies": {
    "@angular/build": "21.2.24",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.23",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/three": "^0.183.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "4.1.11"
  }
}
